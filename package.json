{
  "name": "claude-luxure",
  "displayName": "Claude Luxure",
  "description": "Cursor-like UI for Claude Code CLI — drag-drop files, paste images, Agent/Plan modes, inline diff accept/reject",
  "version": "0.1.0",
  "publisher": "claude-luxure",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:claude-luxure.openChat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-luxure",
          "title": "Claude Luxure",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claude-luxure": [
        {
          "type": "webview",
          "id": "claude-luxure.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "claude-luxure.openChat",
        "title": "Open Claude Luxure",
        "icon": {
          "light": "media/icon-button.svg",
          "dark": "media/icon-button.svg"
        }
      },
      {
        "command": "claude-luxure.acceptChange",
        "title": "Claude Luxure: Accept Change"
      },
      {
        "command": "claude-luxure.rejectChange",
        "title": "Claude Luxure: Reject Change"
      },
      {
        "command": "claude-luxure.acceptAllChanges",
        "title": "Claude Luxure: Accept All Changes"
      },
      {
        "command": "claude-luxure.rejectAllChanges",
        "title": "Claude Luxure: Reject All Changes"
      },
      {
        "command": "claude-luxure.addToChat",
        "title": "Add to Claude Luxure"
      },
      {
        "command": "claude-luxure.voiceToggle",
        "title": "Claude Luxure: Toggle Voice"
      },
      {
        "command": "claude-luxure.voiceStop",
        "title": "Claude Luxure: Stop Speaking"
      },
      {
        "command": "claude-luxure.voiceSetElevenLabsKey",
        "title": "Claude Luxure: Set ElevenLabs API Key"
      }
    ],
    "keybindings": [
      {
        "command": "claude-luxure.openChat",
        "key": "ctrl+shift+alt+c",
        "mac": "cmd+shift+alt+c"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "claude-luxure.openChat",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "claude-luxure.openChat",
          "when": "true"
        }
      ],
      "explorer/context": [
        {
          "command": "claude-luxure.addToChat",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "claude-luxure.addToChat",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "claude-luxure.addToChat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Claude Luxure",
      "properties": {
        "claude-luxure.claudePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `claude` CLI binary. Leave empty to auto-detect (PATH, common install locations, and the native binary bundled with the official Claude Code extension). Set this if sends fail with `spawn claude ENOENT`."
        },
        "claude-luxure.codexPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `codex` CLI binary, used by Codex accounts. Leave empty to auto-detect (common install locations, then the binary bundled with the official Codex/ChatGPT extension). Set this if Codex sends fail with `spawn codex ENOENT`."
        },
        "claude-luxure.voice.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Read Claude's finished replies aloud (focused conversation only). Toggle by clicking the orb above the composer. macOS only."
        },
        "claude-luxure.voice.backend": {
          "type": "string",
          "enum": [
            "say",
            "elevenlabs"
          ],
          "enumDescriptions": [
            "macOS system voice — free, no key",
            "ElevenLabs — premium voices; needs a key (\"Claude Luxure: Set ElevenLabs API Key\"). Falls back to `say` on error."
          ],
          "default": "say",
          "description": "Text-to-speech engine for voice mode."
        },
        "claude-luxure.voice.sayVoice": {
          "type": "string",
          "default": "Samantha",
          "markdownDescription": "macOS voice name for `say` (list them with `say -v ?`)."
        },
        "claude-luxure.voice.sayRate": {
          "type": "number",
          "default": 200,
          "minimum": 80,
          "maximum": 400,
          "description": "Speech rate for the system voice, in words per minute."
        },
        "claude-luxure.voice.elevenlabsVoiceId": {
          "type": "string",
          "default": "pNInz6obpgDQGcFmaJgB",
          "description": "ElevenLabs voice ID (default: Adam)."
        },
        "claude-luxure.voice.elevenlabsModel": {
          "type": "string",
          "enum": [
            "eleven_flash_v2_5",
            "eleven_turbo_v2_5",
            "eleven_multilingual_v2"
          ],
          "default": "eleven_flash_v2_5",
          "description": "ElevenLabs model."
        },
        "claude-luxure.voice.elevenlabsSpeed": {
          "type": "number",
          "default": 0.9,
          "minimum": 0.7,
          "maximum": 1.2,
          "description": "ElevenLabs speaking speed."
        },
        "claude-luxure.voice.rephrase": {
          "type": "boolean",
          "default": true,
          "description": "Rewrite long replies into natural spoken form with Claude Haiku before reading them (uses your Claude login, no API key)."
        },
        "claude-luxure.voice.rephraseThreshold": {
          "type": "number",
          "default": 180,
          "minimum": 0,
          "description": "Replies shorter than this many characters are read as-is, without rephrasing."
        },
        "claude-luxure.voice.brevity": {
          "type": "string",
          "enum": [
            "detailed",
            "balanced",
            "brief",
            "minimal"
          ],
          "default": "balanced",
          "description": "How much the rephrase condenses long replies."
        },
        "claude-luxure.voice.orbStyle": {
          "type": "string",
          "enum": [
            "glass",
            "plasma",
            "iridescent",
            "energy"
          ],
          "default": "plasma",
          "description": "Look of the voice orb above the composer."
        },
        "claude-luxure.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 11,
          "maximum": 24,
          "markdownDescription": "Text size (px) for the conversation and the message box, independent of the editor's own zoom. Adjust it from the **Aa** control in the composer bar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "prepare": "git submodule update --init vendor/lightpanda || true",
    "setup": "./setup.sh",
    "build": "npm run build:webview && npm run build:ext && npm run build:mcp",
    "build:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:node-llama-cpp --format=cjs --platform=node --sourcemap",
    "build:mcp": "esbuild src/mcp/luxure-mcp-server.ts --bundle --outfile=dist/luxure-mcp.js --format=cjs --platform=node --sourcemap && esbuild src/mcp/lightpanda-mcp-launcher.ts --bundle --outfile=dist/lightpanda-mcp.js --format=cjs --platform=node --sourcemap && esbuild src/cli/api-bridge-server.ts --bundle --outfile=dist/api-bridge.js --format=cjs --platform=node --sourcemap",
    "lightpanda:build": "git submodule update --init vendor/lightpanda && cd vendor/lightpanda && zig build --release=safe",
    "build:webview": "cd webview-ui && npm run build",
    "watch:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:node-llama-cpp --format=cjs --platform=node --sourcemap --watch",
    "watch:mcp": "esbuild src/mcp/luxure-mcp-server.ts --bundle --outfile=dist/luxure-mcp.js --format=cjs --platform=node --sourcemap --watch",
    "watch:webview": "cd webview-ui && npm run dev",
    "dev": "concurrently \"npm run watch:ext\" \"npm run watch:mcp\" \"npm run watch:webview\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "chrome-devtools-mcp": "^1.10.1",
    "diff": "^7.0.0",
    "node-llama-cpp": "^3.19.1"
  }
}
